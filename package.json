{
  "name": "dsh-itab",
  "version": "0.3.6",
  "author": "morgan",
  "description": "DSH web plugin: browser-style session tabs for the conversation header — roomier tabs, middle-click close, and one-click close others / close right / close all / reopen closed.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super-new13/dsh-iTab.git"
  },
  "bugs": {
    "url": "https://github.com/super-new13/dsh-iTab/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.bundle.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "tests",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/branch.test.js tests/bundle.test.js tests/client-parts.test.js tests/editor.test.js tests/hooks.test.js tests/model.test.js",
    "verify": "npm run build && npm test",
    "prepack": "npm run build",
    "version": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('dsh.plugin.json','utf8'));const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;m.version=v;fs.writeFileSync('dsh.plugin.json',JSON.stringify(m,null,2)+'\\n')\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tabs",
    "session-tabs"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
